{
  "name": "dev-reymark/laravel-source-encryptor",
  "description": "Encrypt Laravel source code for secure Laravel distribution",
  "keywords": [
    "laravel",
    "encryption",
    "source-protection",
    "code-protection",
    "laravel-package"
  ],
  "homepage": "https://github.com/dev-reymark/laravel-source-encryptor",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Rey Mark Tapar",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "DevReymark\\SourceEncryptor\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DevReymark\\SourceEncryptor\\SourceEncryptorServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^7.2.5 || ^8.0",
    "illuminate/support": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0"
  },
  "config": {
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "minimum-stability": "stable"
}
